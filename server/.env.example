# Threadline server environment.
# Copy this file to .env and replace every placeholder. Never commit .env.
# Real process environment variables override values read from --env-file.

HOST=127.0.0.1
PORT=8787

# Public URL where this service's /api/auth/callback is reachable. Behind a
# TLS reverse proxy this is usually https://comments.example.com.
PUBLIC_BASE_URL=http://127.0.0.1:8787

# Browser origins allowed to call the API cross-origin. Use exact scheme,
# host, and port. Add several values separated by commas, for example:
# http://127.0.0.1:1313,http://localhost:1313
SITE_ORIGINS=http://127.0.0.1:1313

# Local HTTP development can use false. Production HTTPS must use true.
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax

# Repository that stores the public Issues. The GitHub App or OAuth App must
# be able to create/read Issues there.
COMMENTS_REPOSITORY=owner/repo
BLOGGER_GITHUB_LOGIN=your-github-login
# Optional existing label applied when a new comments Issue is created.
ISSUE_LABEL=

DATABASE_PATH=./data/threadline.db
GITHUB_API_BASE=https://api.github.com
GITHUB_OAUTH_AUTHORIZE_URL=https://github.com/login/oauth/authorize
GITHUB_OAUTH_TOKEN_URL=https://github.com/login/oauth/access_token

# Create a GitHub App or OAuth App. These are placeholders only.
GITHUB_CLIENT_ID=replace-with-client-id
GITHUB_CLIENT_SECRET=replace-with-client-secret

# Recommended: leave empty when using a GitHub App (user-to-server auth).
# An OAuth App for a public repository can use public_repo instead. public_repo
# is broader; private repositories would need the broader repo scope.
GITHUB_OAUTH_SCOPE=

# Optional read-only token used for public reads / rate-limit headroom.
# It is NEVER used for writes, comments, reactions, or issue creation.
GITHUB_READ_TOKEN=

SESSION_TTL_SECONDS=28800

# Attachments are public when enabled. disabled | local | http
ATTACHMENTS_MODE=disabled
# Required for local mode. Mount/persist this directory in production.
ATTACHMENTS_DIR=./data/attachments
# Base URL used by the local driver: <base>/uploads/<random-token>.
# Empty means PUBLIC_BASE_URL. It does not need to be on this server's origin.
ATTACHMENTS_PUBLIC_BASE_URL=
# Required for http mode. Receives a multipart POST with bearer auth.
ATTACHMENTS_HTTP_URL=
ATTACHMENTS_HTTP_TOKEN=
ATTACHMENTS_MAX_BYTES=5242880
ATTACHMENTS_ALLOWED_TYPES=image/png,image/jpeg,image/gif,image/webp,application/pdf,text/plain
